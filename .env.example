TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key
CONTACT_WEBHOOK_URL=https://example.com/your-lead-webhook
PORT=5601

# --- Landing Ads « Offre Guéliz » (/offre-gueliz) ---
# HubSpot Forms API (public, aucun token privé requis — recommandé côté client-safe)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# HubSpot CRM (token privé, UNIQUEMENT côté serveur, ne jamais exposer au client)
HUBSPOT_ACCESS_TOKEN=
# Webhook de repli dédié (sinon CONTACT_WEBHOOK_URL est réutilisé)
GUELIZ_WEBHOOK_URL=

# --- Snapchat Pixel (emaraestates.com — global base + BuyerLead / RecruitmentApplication) ---
# Default in code: 131b50b1-799c-4d5c-a2e5-343feb50333a. Override only for staging if needed.
NEXT_PUBLIC_SNAP_PIXEL_ID=131b50b1-799c-4d5c-a2e5-343feb50333a

# --- Contact From/To used by PHP mail() (contact.php + recruitment.php) ---
CONTACT_TO=contact@example.com
CONTACT_FROM=contact@example.com

# --- Recrutement commercial (/recrutement-commercial-marrakech) ---
# Delivery = PHP mail() only (same as contact.php email path). No SMTP.
# Default if unset: contact@emaraestates.com
RECRUITMENT_EMAIL_TO=contact@emaraestates.com

# Optional legacy SMTP keys (used only by contact.php fallback — not recruitment)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Meta Conversions API (server only — NEVER prefix with NEXT_PUBLIC_) ---
# Dataset access token (Events Manager → dataset → Settings → Conversions API).
# Without it every server event is skipped (logged) and the site behaves as before.
META_ACCESS_TOKEN=
# Dataset / Pixel ID. Default in code: 1049553054304565 (the site's Pixel).
META_PIXEL_ID=
# Default in code: v26.0 (latest on 2026-09-28). Override only to pin/upgrade.
META_GRAPH_API_VERSION=
# Events Manager → Test events code. Set for validation; remove for production.
META_TEST_EVENT_CODE=

# --- HubSpot → Meta qualification events (POST /meta-crm-webhook.php) ---
# Uses HUBSPOT_ACCESS_TOKEN above — its app needs crm.objects.contacts.read.
# Client secret of that HubSpot app: verifies X-HubSpot-Signature-v3 / v1.
HUBSPOT_CLIENT_SECRET=
# REQUIRED to enable CRM events: activation instant, ISO 8601 (e.g.
# 2026-10-01T09:00:00Z). CRM changes before it are never sent (no backfill).
META_CRM_START_AT=
# 1 = also send `Schedule` when rdv becomes OUI. Keep 0 until confirmed.
META_CRM_SCHEDULE_ENABLED=0
# Zapier fallback ONLY (header X-Emara-Webhook-Secret). Leave empty when the
# HubSpot webhook is used. Long random string.
META_CRM_ZAPIER_SECRET=
# Optional. Default: <parent of public_html>/emara-meta-ledger (outside web root).
META_LEDGER_DIR=

# --- Abandoned-form drafts (POST /lead-draft.php) — all optional ---
# Notifications go to CONTACT_TO, through the same mail()/SMTP settings as leads.
# 1 = turn the whole feature off (the endpoint then stores and sends nothing).
LEAD_DRAFTS_DISABLED=
# 0 = keep the "Lead abandonné" e-mail but not the "Nouveau prospect en cours" one.
LEAD_DRAFTS_PARTIAL_EMAIL=
# Default: <parent of public_html>/emara-lead-drafts (outside the web root).
LEAD_DRAFTS_DIR=

# ── Today's activity on /honest-signature-7/ (activity.php) ──────────────────
# Requests received today, counted by contact.php when a lead is accepted.
# 1 = stop counting and hide the band on the page.
ACTIVITY_DISABLED=
# Default: <parent of public_html>/emara-activity (outside the web root).
ACTIVITY_DIR=
