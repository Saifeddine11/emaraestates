PORT=5601

# --- Landing Ads « Offre Guéliz » (/offre-gueliz) ---
# HubSpot Forms API (public, aucun token privé requis — recommandé côté client-safe)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# HubSpot CRM (token privé, UNIQUEMENT côté serveur, ne jamais exposer au client)
HUBSPOT_ACCESS_TOKEN=
# Webhook de repli dédié (sinon CONTACT_WEBHOOK_URL est réutilisé)
GUELIZ_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact@emaraestates.com
SMTP_PASS=your_google_app_password
CONTACT_TO=contact@emaraestates.com
CONTACT_FROM=contact@emaraestates.com
