TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key
CONTACT_WEBHOOK_URL=https://example.com/your-lead-webhook
PORT=5601

# --- Landing Ads « Offre Guéliz » (/offre-gueliz) ---
# HubSpot Forms API (public, aucun token privé requis — recommandé côté client-safe)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# HubSpot CRM (token privé, UNIQUEMENT côté serveur, ne jamais exposer au client)
HUBSPOT_ACCESS_TOKEN=
# Webhook de repli dédié (sinon CONTACT_WEBHOOK_URL est réutilisé)
GUELIZ_WEBHOOK_URL=

# --- SMTP (ne jamais committer les vraies valeurs) ---
# Hostinger production prefers PHP mail() for contact/recruitment.
# SMTP is only a fallback. If using Gmail, SMTP_PASS must be a 16-char App Password
# (2FA required) — not the normal mailbox password.
# For Hostinger mailboxes use smtp.hostinger.com instead of smtp.gmail.com.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_mailbox_or_app_password
CONTACT_TO=contact@example.com
CONTACT_FROM=contact@example.com

# --- Recrutement commercial (/recrutement-commercial-marrakech) ---
# Destinataire des candidatures (email uniquement, pas HubSpot / Zapier)
# Must also exist as a GitHub Actions secret so CI can write deploy/.env on Hostinger.
RECRUITMENT_EMAIL_TO=recruitment@example.com
