Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Force a single canonical host: redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.emaraestates\.com$ [NC]
RewriteRule ^ https://emaraestates.com%{REQUEST_URI} [R=301,L,NE]

# Redirect /page.html to /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Internally rewrite /page to /page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
